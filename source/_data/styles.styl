// Warm paper / navy ink / copper, sampled from the 盗火者 reference.
// Loaded through NexT's supported custom_file_path; no npm theme edits.
:root {
  --paper: #f5eddc;
  --ink: #17263b;
  --copper: #b75d32;
  --muted: #75654f;
  --rule: #d8c5a4;
}

body {
  -webkit-font-smoothing: antialiased;
  background-image: linear-gradient(rgba(96, 74, 43, .024) 1px, transparent 1px);
  background-size: 100% 7px;
}
.headband { height: 4px; background: var(--copper); }
.main {
  width: calc(100% - 64px);
  max-width: 1080px;
  margin: 32px auto 0;
  gap: 28px;
}
.main-inner {
  width: calc(100% - 268px);
  padding: 0;
  background: transparent;
  box-shadow: none;
}
.column { width: 240px; flex-shrink: 0; }
header.header {
  border: 1px solid var(--rule);
  box-shadow: none;
  background: var(--paper);
}
.site-brand-container {
  background: var(--ink);
  border-top: 4px solid #d97735;
}
.site-meta { padding: 28px 14px; }
.site-title {
  font-size: 21px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1.6;
}
.site-subtitle { color: #c6ced9; }
.menu { padding: 12px 0; }
.menu-item a, .menu-item button {
  color: var(--ink);
  font-size: 14px;
  padding: 9px 22px;
}
.menu-item a:hover, .menu-item button:hover, .menu-item-active a {
  color: #a24d23;
  background: #eadcc3;
}
.sidebar-inner {
  background: var(--paper);
  border: 1px solid var(--rule);
  box-shadow: none;
}
.site-author-name, .site-state-item-count { color: var(--ink); }
.sidebar-nav .sidebar-nav-active, .sidebar-nav li:hover,
.sidebar-toc-active .sidebar-toc .nav .active > a {
  color: var(--copper);
  border-bottom-color: var(--copper);
}

.post-block, .post-block:first-of-type {
  padding: 34px 44px 40px;
  margin-bottom: 28px;
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: var(--paper);
  background-image: linear-gradient(rgba(96, 74, 43, .024) 1px, transparent 1px);
  background-size: 100% 7px;
  box-shadow: 0 8px 24px rgba(65, 48, 27, .04);
}
.posts-expand .post-header {
  margin: 0 0 34px;
  padding: 30px 24px 26px;
  background: var(--ink);
  border-top: 6px solid #d97735;
  box-shadow: 0 8px 22px rgba(23, 38, 59, .12);
}
.posts-expand .post-title, .posts-expand .post-title-link {
  color: #fff8e8;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: .5px;
}
.posts-expand .post-title-link::before { background: #d9a15b; }
.posts-expand .post-meta-container {
  margin-top: 18px;
  color: #c6ced9;
  font-family: $font-family-base;
  font-size: 12px;
  line-height: 1.9;
}
.post-header .post-meta a {
  color: #e6bc83;
  border-bottom-color: rgba(230, 188, 131, .45);
}
.post-header .post-meta time { border: 0; }

.post-body {
  max-width: 720px;
  margin: 0 auto;
  color: #273444;
  font-size: 17px;
  line-height: 1.95;
  text-align: left;

  p { margin: 0 0 21px; }
  h1, h2, h3, h4, h5, h6 {
    color: #18263a;
    font-weight: 700;
    scroll-margin-top: 28px;
  }
  h1 {
    margin: 40px 0 24px;
    font-size: 27px;
    line-height: 1.5;
    text-align: center;
    border: 0;
  }
  h2 {
    margin: 40px 0 20px;
    padding: 6px 0 6px 13px;
    border: 0;
    border-left: 4px solid #d97735;
    font-size: 22px;
    line-height: 1.5;
  }
  h3 { margin: 30px 0 16px; font-size: 20px; }
  strong { color: #13243b; font-weight: 800; }
  em { color: #a24d23; }
  ul, ol { padding-left: 1.7em; margin-bottom: 28px; }
  li { padding-left: .3em; margin-bottom: 12px; }
  li::marker { color: var(--copper); font-weight: 700; }
  ol { list-style-type: decimal-leading-zero; }

  blockquote {
    margin: 32px 0;
    padding: 24px 26px;
    background: var(--ink);
    border: 0;
    border-left: 5px solid #d97735;
    border-radius: 2px;
    color: #fff8e8;
    box-shadow: 0 8px 22px rgba(23, 38, 59, .10);
    font-size: 18px;

    p:last-child, ul:last-child, ol:last-child { margin-bottom: 0; }
    strong, em, a, li::marker { color: #e6bc83; }
    h1, h2, h3, h4, h5, h6 { color: #fff8e8; }
    blockquote { padding: 12px 18px; box-shadow: none; }
  }

  figure.editorial-figure, figure:not(.highlight) {
    margin: 26px 0 32px;
    padding: 6px 6px 12px;
    background: #eadcc3;
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 8px 20px rgba(43, 35, 24, .10);

    img {
      display: block;
      box-sizing: border-box;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
      padding: 0;
      border: 0;
      border-radius: 2px;
    }
    figcaption {
      margin: 11px 4px 0;
      color: #75654f;
      font-family: $font-family-base;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.6;
      letter-spacing: 1px;
      text-align: center;
    }
  }
  hr {
    margin: 40px auto;
    width: 64px;
    height: 2px;
    border: 0;
    background: var(--copper);
    background-image: none;
  }
  code { color: #91451f; background: #eadcc3; border-radius: 3px; }
  .highlight {
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-size: 13px;
    line-height: 1.7;
  }
  table { font-family: $font-family-base; font-size: 14px; }
}

.index .post-body { font-size: 16px; }
.index .post-body > h1:first-child { margin-top: 0; font-size: 22px; }
.index .post-title, .index .post-title-link { font-size: 25px; }
.post-button { margin-top: 28px; }
.post-button .btn {
  padding: 6px 22px;
  border-width: 1px;
  border-radius: 2px;
  font-family: $font-family-base;
  font-size: 13px;
}
.post-eof { display: none; }
.post-copyright {
  padding: 16px 20px;
  background: #efe3cd;
  border-left: 3px solid var(--copper);
  font-size: 13px;
  overflow-wrap: anywhere;
}
.post-nav { border-top-color: var(--rule); font-size: 14px; }
.post-tags a, .tag-cloud-tags a {
  padding: 3px 9px;
  margin: 4px;
  border: 1px solid var(--rule);
  border-radius: 2px;
}
.pagination { margin: 36px 0; border: 0; }
.pagination .page-number.current {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff8e8;
}
.footer { color: var(--muted); font-size: 12px; }
.footer-inner {
  box-sizing: border-box;
  width: calc(100% - 64px);
  max-width: 1080px;
  padding-right: 268px;
}
.search-popup { background: var(--paper); color: var(--ink); }
a:focus-visible, button:focus-visible, input:focus-visible {
  outline: 2px solid var(--copper);
  outline-offset: 4px;
}

@media (max-width: 991px) {
  .main {
    display: block;
    width: calc(100% - 40px);
    max-width: 812px;
    margin-top: 20px;
  }
  .column, .main-inner { width: 100%; }
  .main-inner { padding: 0; margin-top: 20px; }
  .site-meta { padding: 22px 48px; }
  .menu { margin: 0; }
  .site-nav { min-width: 0; background: var(--paper); }
  .menu-item a, .menu-item button { white-space: nowrap; }
  // NexT uses a navy off-canvas sidebar on tablet and phone.
  .sidebar-inner { background: transparent; border: 0; }
  .sidebar { background: var(--ink); }
  .sidebar .site-author-name, .sidebar .site-state-item-count { color: #fff8e8; }
  .footer-inner { width: 100%; padding: 0 20px; }
}

@media (max-width: 767px) {
  .main { width: 100%; margin-top: 0; }
  header.header { border: 0; }
  .site-title { font-size: 19px; }
  .main-inner { margin-top: 0; }
  .post-block, .post-block:first-of-type {
    padding: 22px 20px 30px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    margin-bottom: 16px;
    box-shadow: none;
  }
  .posts-expand .post-header { margin-bottom: 28px; padding: 24px 18px 22px; }
  .posts-expand .post-title, .posts-expand .post-title-link { font-size: 25px; }
  .posts-expand .post-meta-container { font-size: 11px; margin-top: 14px; }
  .post-body {
    font-size: 17px;
    h1 { font-size: 25px; }
    h2 { font-size: 21px; }
    blockquote { padding: 22px 20px; font-size: 17px; }
  }
  .index .post-title, .index .post-title-link { font-size: 23px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
